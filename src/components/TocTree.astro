---
interface TocNode {
  slug: string;
  text: string;
  depth: number;         // profundidad normalizada (1, 2, 3...)
  rawDepth: number;      // profundidad original del markdown (1..6)
  children: TocNode[];
}

interface Props {
  items: TocNode[];
  level?: number;
}

const { items, level = 1 } = Astro.props;
---

<ul class:list={["toc-tree", level > 1 && "toc-tree-nested"]}>
  {items.map((item) => {
    const hasChildren = item.children.length > 0;
    return (
      <li
        data-has-children={hasChildren ? "true" : "false"}
        data-toc-slug={item.slug}
      >
        <a
          href={`#${item.slug}`}
          data-toc-link={item.slug}
          data-toc-depth={item.rawDepth}
          class="toc-link"
        >
          {item.text}
        </a>
        {hasChildren && (
          <Astro.self items={item.children} level={level + 1} />
        )}
      </li>
    );
  })}
</ul>