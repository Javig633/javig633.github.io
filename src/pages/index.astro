---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Inicio | 0xSkunk"
  description="Portfolio de ciberseguridad"
  wide
>  
  <section class="max-w-2xl">
    <p class="font-mono text-sm text-[#9ab8ff] mb-3">$ whoami</p>
    <h1 class="text-4xl font-bold mb-4 text-white">En construccion..</h1>
    <p class="text-lg text-[#9aa1ae] mb-6 leading-relaxed">
      En construccion..
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href="/writeups"
        class="px-4 py-2 bg-[#9ab8ff] text-[#262932] rounded-lg text-sm font-medium hover:bg-[#b0c7ff] transition-colors"
      >
        Ver writeups →
      </a>
      <a
        href="https://github.com/tu-usuario"
        class="px-4 py-2 border border-[#3a3f4a] rounded-lg text-sm font-medium text-[#dce0e6] hover:bg-[#2e323c] transition-colors"
      >
        GitHub
      </a>
    </div>
  </section>
</BaseLayout>